# Frontend (safe for browser — also set these in Vercel Project Settings)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional production CORS allowlist (comma-separated). Vercel/Netlify previews are allowed by default.
FRONTEND_ORIGIN=

# API server / Edge Function secrets — NEVER put these in VITE_* vars
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Used for fast responses / when Gemma is slow or unavailable
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# true = prefer Flash Lite first (snappy demos); false = prefer Gemma first
FAST_DEMO_MODE=true
# Gemma abort timeout (ms) before trying the next model
GEMMA_TIMEOUT_MS=8000
# Optional override: v1 (Gemma) or v1beta (Gemini). Auto-selected if unset.
# GEMINI_API_VERSION=v1
YOUTUBE_API_KEY=

# Local API server
API_PORT=8787
